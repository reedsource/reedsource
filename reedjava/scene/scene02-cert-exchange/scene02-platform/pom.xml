<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>top.ireed</groupId>
        <artifactId>scene02-cert-exchange</artifactId>
        <version>1.0.0</version>
    </parent>
    <packaging>jar</packaging>
    <artifactId>scene02-platform</artifactId>
    <version>1.0.0</version>
    <name>scene02-platform</name>
    <description>场景02 平台方(京东方)独立SpringBoot工程:提供8.1.1获取平台公钥证书接口,定时拉取资方方证书</description>

    <dependencies>
        <!--场景公共工具类模块-->
        <dependency>
            <groupId>top.ireed</groupId>
            <artifactId>scene02-common</artifactId>
            <version>1.0.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>top.ireed.scene02.platform.PlatformApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
